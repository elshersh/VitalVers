# Vitalverse runtime configuration example (copy to .env if needed; never commit .env)
ASTRO_HEALTH_DB=
VITALVERSE_COOKIE_SECURE=

# Online AI Assistant engine configuration
# Supported providers: gemini | anthropic | groq
ONLINE_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Optional SMTP transport for Mental Health check-in emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional VAPID keys for PWA Web Push alerts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
